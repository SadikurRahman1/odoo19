<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_users_form_pos_role" model="ir.ui.view">
        <field name="name">res.users.form.pos.role</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">

            <xpath expr="//sheet/notebook" position="inside">
                <page string="POS Role">
                    <group>
                        <field name="pos_role"/>
                        <div class="oe_edit_only" attrs="{'invisible': [('pos_role', '!=', 'admin')]}">
                            <p class="text-info">
                                Admin role allows creating sales, processing POS orders, and collecting cash payments.
                            </p>
                        </div>
                        <div class="oe_edit_only" attrs="{'invisible': [('pos_role', '!=', 'salesman')]}">
                            <p class="text-warning">
                                Salesman role: You can only create sales orders. Cash collection is restricted.
                            </p>
                        </div>
                        <div class="oe_edit_only" attrs="{'invisible': [('pos_role', '!=', 'cashier')]}">
                            <p class="text-warning">
                                Cashier role: You can process payments but cash collection is restricted.
                            </p>
                        </div>
                    </group>
                </page>
            </xpath>

        </field>
    </record>

</odoo>
