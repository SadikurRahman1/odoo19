<?xml version="1.0" encoding="UTF-8"?>

<odoo>

    <!-- Program List -->

    <record id="program_list" model="ir.ui.view">

        <field name="name">student.management.program.list</field>
        <field name="model">student_management.program</field>

        <field name="arch" type="xml">

            <list>

                <field name="code"/>
                <field name="name"/>
                <field name="department_id"/>
                <field name="duration"/>
                <field name="active"/>

            </list>

        </field>

    </record>


    <!-- Program Form -->

    <record id="program_form" model="ir.ui.view">

        <field name="name">student.management.program.form</field>
        <field name="model">student_management.program</field>

        <field name="arch" type="xml">

            <form>

                <sheet>

                    <group>

                        <field name="name"/>
                        <field name="code"/>
                        <field name="department_id"/>

                    </group>

                    <group>

                        <field name="duration"/>
                        <field name="active"/>

                    </group>

                    <group>

                        <field name="description"/>

                    </group>

                </sheet>

            </form>

        </field>

    </record>


    <!-- Program Action -->

    <record id="program_action" model="ir.actions.act_window">

        <field name="name">Programs</field>
        <field name="res_model">student_management.program</field>
        <field name="view_mode">list,form</field>

    </record>

</odoo>