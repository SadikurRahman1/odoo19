<?xml version="1.0" encoding="UTF-8"?>

<odoo>

    <!-- ========================= -->
    <!-- Batch List View -->
    <!-- ========================= -->

    <record id="batch_list" model="ir.ui.view">

        <field name="name">student.management.batch.list</field>
        <field name="model">student_management.batch</field>

        <field name="arch" type="xml">

            <list>

                <field name="code"/>
                <field name="name"/>
                <field name="program_id"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="active"/>

            </list>

        </field>

    </record>


    <!-- ========================= -->
    <!-- Batch Form View -->
    <!-- ========================= -->

    <record id="batch_form" model="ir.ui.view">

        <field name="name">student.management.batch.form</field>
        <field name="model">student_management.batch</field>

        <field name="arch" type="xml">

            <form>

                <sheet>

                    <!-- Batch Information -->

                    <group string="Batch Information">

                        <group>

                            <field name="name"/>
                            <field name="code"/>

                        </group>

                        <group>

                            <field name="program_id"/>

                        </group>

                    </group>


                    <!-- Batch Duration -->

                    <group string="Batch Duration">

                        <group>

                            <field name="start_date"/>

                        </group>

                        <group>

                            <field
                                name="end_date"
                                readonly="1"
                            />

                        </group>

                    </group>


                    <!-- Description -->

                    <group string="Description">

                        <field name="description"/>

                    </group>


                    <!-- Status -->

                    <group string="Status">

                        <field name="active"/>

                    </group>


                    <!-- Students -->

                    <notebook>

                        <page string="Students">

                            <field name="student_ids">

                                <list>

                                    <field name="student_id"/>
                                    <field name="name"/>
                                    <field name="email"/>
                                    <field name="phone"/>
                                    <field name="semester"/>
                                    <field name="status"/>

                                </list>

                            </field>

                        </page>

                    </notebook>

                </sheet>

            </form>

        </field>

    </record>


    <!-- ========================= -->
    <!-- Batch Action -->
    <!-- ========================= -->

    <record id="batch_action" model="ir.actions.act_window">

        <field name="name">Batches</field>

        <field name="res_model">student_management.batch</field>

        <field name="view_mode">list,form</field>

    </record>

</odoo>