<?xml version="1.0" encoding="UTF-8"?>

<odoo>

    <!-- Department List -->

    <record id="department_list" model="ir.ui.view">

        <field name="name">student.management.department.list</field>
        <field name="model">student_management.department</field>

        <field name="arch" type="xml">

            <list>

                <field name="code"/>
                <field name="name"/>
                <field name="active"/>

            </list>

        </field>

    </record>


    <!-- Department Form -->

    <record id="department_form" model="ir.ui.view">

        <field name="name">student.management.department.form</field>
        <field name="model">student_management.department</field>

        <field name="arch" type="xml">

            <form>

                <sheet>

                    <group>

                        <field name="name"/>
                        <field name="code"/>
                        <field name="active"/>

                    </group>

                    <group>

                        <field name="description"/>

                    </group>

                </sheet>

            </form>

        </field>

    </record>


    <!-- Department Action -->

    <record id="department_action" model="ir.actions.act_window">

        <field name="name">Departments</field>
        <field name="res_model">student_management.department</field>
        <field name="view_mode">list,form</field>

    </record>

</odoo>